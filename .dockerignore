# Dependencies — rebuilt inside container
vendor/

# Local environment — never bake secrets into an image. Everything except the
# committed example: Laravel prefers .env.{APP_ENV} when it exists, so a stray
# local .env.production baked into an image overrides the container's env_file.
.env*
!.env.example

# Version control
.git/
.gitignore

# Dev tooling
.github/
.vscode/
*.md

# Test artifacts
coverage/
.phpunit.result.cache

# OS artifacts
.DS_Store
Thumbs.db

# Build artifacts
public/hot
